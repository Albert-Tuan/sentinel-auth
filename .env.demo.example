# Sentinel Auth v3.3 — M13 demo environment template
#
# Copy to `.env.demo` (gitignored) and fill in the secrets:
#
#   cp .env.demo.example .env.demo
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # INTERNAL_SECRET
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"   # POSTGRES_PASSWORD
#
# `.env.demo` is read by `scripts/demo_stack.sh` ONLY.  The existing
# `scripts/deploy_local.sh` keeps reading `.env`, so the two deployments
# never fight over the same file.
#
# ---------------------------------------------------------------------------
# WHY A SEPARATE FILE
# ---------------------------------------------------------------------------
# The demo stack runs on its OWN ports and its OWN database names, so it
# can never collide with:
#
#   * a developer's existing `scripts/deploy_local.sh` deployment;
#   * the CI's disposable `*_test` databases;
#   * any real deployment.
#
# The database names carry the `_demo` marker.  Every M13 fixture script
# refuses to run against a database whose name does NOT carry that marker,
# so a mistake can never write into a production or a test database.
#
# The passwords here are DEMO credentials.  They are generated for a
# throwaway local database and are worthless anywhere else.  They are still
# not committed: `.env.demo` is gitignored, and this template only holds
# placeholders.

# =============================================================================
# POSTGRESQL — the demo server
# =============================================================================

POSTGRES_USER=sentinel
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
POSTGRES_PASSWORD=change-me-demo-postgres-password

# The host port PostgreSQL is published on.  The default is deliberately
# NOT 5432, so a demo stack can coexist with an existing local deployment.
POSTGRES_PORT=55432

# The three demo databases.  The `_demo` marker is what the fixture
# scripts check before they write anything.
CORE_DB=sentinel_core_demo
DETECTION_DB=sentinel_detection_demo
ML_DB=sentinel_ml_demo

CORE_DATABASE_URL=postgresql://sentinel:change-me-demo-postgres-password@localhost:55432/sentinel_core_demo
DETECTION_DATABASE_URL=postgresql://sentinel:change-me-demo-postgres-password@localhost:55432/sentinel_detection_demo
ML_DATABASE_URL=postgresql://sentinel:change-me-demo-postgres-password@localhost:55432/sentinel_ml_demo

# The legacy single-database fallback stays DISABLED: the demo runs the
# real three-database topology.
ALLOW_LEGACY_SINGLE_DB=0

# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=redis://localhost:56379/0
REDIS_PORT=56379

# =============================================================================
# INTERNAL SECRET
# =============================================================================
# At least 32 characters.  The placeholder below is REFUSED by both
# `scripts/demo_stack.sh` and the application itself.
#
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=change-me-to-a-demo-secret-at-least-32-chars

# =============================================================================
# THE MONOLITH
# =============================================================================
# Core, Detection and ML are served by ONE FastAPI process.  Both URLs
# therefore point at that process — the same rule the canonical deployment
# enforces.
CORE_APP_URL=http://localhost:58000
DETECTION_URL=http://localhost:58000

APP_HOST=127.0.0.1
APP_PORT=58000

# =============================================================================
# THE FRONTEND
# =============================================================================
# The Vite dev server.  It binds to 127.0.0.1 on its own port so it
# cannot collide with an existing `npm run dev`.
VITE_DEV_PORT=55173

# The origin the Vite dev server serves.  It MUST be listed in
# CORS_ALLOWED_ORIGINS below, because the demo uses the DIRECT-CORS mode
# (VITE_API_BASE_URL is set), not the dev proxy.
VITE_ORIGIN=http://localhost:55173

# The mode the frontend runs in.
#
#   A. Proxy mode (the default of the repository): leave VITE_API_BASE_URL
#      empty.  The browser makes a same-origin request and Vite proxies
#      /api to VITE_DEV_API_TARGET.  CORS is never exercised.
#
#   B. Direct-CORS mode: set VITE_API_BASE_URL to the API origin.  The
#      browser calls the API cross-origin, so the API origin must be in
#      CORS_ALLOWED_ORIGINS.
#
# The demo stack uses the PROXY mode (A) by default: it is the mode the
# repository documents as recommended, it needs no CORS configuration, and
# it survives a port change of the API without touching the frontend.
#
# Set DEMO_API_MODE=direct to switch to mode B.
DEMO_API_MODE=proxy

# =============================================================================
# CORS
# =============================================================================
# Only needed in direct-CORS mode.  In proxy mode the browser never makes
# a cross-origin request, so the list is harmless either way.
#
# The demo stack refuses to start when this contains a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:55173,http://127.0.0.1:55173,http://localhost:58000,http://127.0.0.1:58000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# The pre-token risk gate.  "1" is safe in the demo: the Detection context
# is the same process, so the gate is reached over the loopback hop.
RUN_PRE_TOKEN_CHECK=1

# Core -> Detection login-event delivery.  "1" makes the SOC screens show
# the alerts the demo user just generated.
RUN_LOGIN_EVENT_DELIVERY=1

# The ML artifact stays EMPTY on purpose.  The registry holds a staged
# placeholder with no file behind it, the scoring endpoint answers 503,
# and the Detection engine falls back to its rule-only score.  That is the
# honest demo state — the deployment reports it rather than hiding it.
ML_MODEL_PATH=

# =============================================================================
# TRUSTED PROXY
# =============================================================================
# A wildcard is FORBIDDEN: it would let any client forge X-Forwarded-For
# and bypass the IP-based controls.
FORWARDED_ALLOW_IPS=127.0.0.1

# =============================================================================
# MFA DELIVERY
# =============================================================================
# The MFA OTP is delivered through a real SMTP hop into a local sink, so
# the demo shows a genuine challenge -> OTP -> verify handshake.  The sink
# writes the captured messages to a file the scenario scripts read.
#
# The path is RELATIVE TO THE REPOSITORY ROOT.  ``scripts/demo_stack.sh``
# resolves it against the repository root before it starts the sink, so
# the sink and the scenario script always read the SAME file regardless
# of the directory either of them is started from.
MFA_SMTP_HOST=127.0.0.1
MFA_SMTP_PORT=51025
MFA_SMTP_LOG=.ci/demo/demo-otp.log

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

APP_ENV=development
