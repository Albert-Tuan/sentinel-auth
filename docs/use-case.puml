@startuml sentinel-auth-use-cases
left to right direction
skinparam actorStyle awesome

actor "User" as user
actor "SOC Analyst" as soc
actor "Security Admin" as admin
actor "Security Manager" as manager
actor "Email / Telegram" as notification

rectangle "Sentinel Auth" {
  usecase "UC-01\nĐăng nhập" as uc01
  usecase "UC-02\nThực hiện MFA" as uc02
  usecase "UC-03\nQuản lý phiên" as uc03
  usecase "UC-04\nXác nhận / báo cáo đăng nhập" as uc04
  usecase "UC-05\nQuản lý thiết bị tin cậy" as uc05
  usecase "UC-06\nTheo dõi dashboard" as uc06
  usecase "UC-07\nTìm kiếm login attempt" as uc07
  usecase "UC-08\nXem evidence rủi ro" as uc08
  usecase "UC-09\nNhận và điều tra alert" as uc09
  usecase "UC-10\nPhân loại incident" as uc10
  usecase "UC-11\nYêu cầu hành động bảo vệ" as uc11
  usecase "UC-12\nĐóng incident" as uc12
  usecase "UC-13\nQuản lý tài khoản / role" as uc13
  usecase "UC-14\nQuản lý version AuthPolicy" as uc14
  usecase "UC-15\nQuản lý RuleSet version" as uc15
  usecase "UC-16\nCấu hình kênh thông báo" as uc16
  usecase "UC-17\nQuản lý trust / block list" as uc17
  usecase "UC-18\nXem audit event" as uc18
  usecase "UC-19\nQuản lý tham số vận hành" as uc19
  usecase "UC-20\nXem dashboard tổng hợp" as uc20
  usecase "UC-21\nXuất báo cáo aggregate" as uc21
  usecase "UC-22\nĐánh giá Rule" as uc22
  usecase "UC-23\nChấm điểm ML" as uc23
  usecase "UC-24\nLưu risk assessment" as uc24
  usecase "UC-25\nTạo alert" as uc25
  usecase "UC-26\nGửi thông báo" as uc26
}

user --> uc01
user --> uc02
user --> uc03
user --> uc04
user --> uc05
soc --> uc06
soc --> uc07
soc --> uc08
soc --> uc09
soc --> uc10
soc --> uc11
soc --> uc12
admin --> uc13
admin --> uc14
admin --> uc15
admin --> uc16
admin --> uc17
admin --> uc18
admin --> uc19
manager --> uc20
manager --> uc21
notification --> uc26

uc02 ..> uc01 : <<extend>>\n[MFA_REQUIRED]
uc09 ..> uc08 : <<include>>
uc10 ..> uc09 : <<extend>>
uc11 ..> uc09 : <<extend>>
uc12 ..> uc09 : <<extend>>
uc22 ..> uc24 : <<include>>
uc23 ..> uc24 : <<include>>
uc25 ..> uc24 : <<extend>>\n[risk >= threshold]
uc26 ..> uc25 : <<extend>>\n[channel configured]
@enduml
