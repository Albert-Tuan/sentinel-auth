@startuml
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam actorStyle awesome

title WF-1: Đăng nhập (Login Flow)

participant "User\n(Browser)" as U #D5E8D4
participant "Auth API" as A #DAE8FC
participant "PostgreSQL" as DB #F5F5F5
participant "MFA\n(TOTP/Email)" as MFA #E1D5E7

== Đăng nhập ==

U -> A : **1. POST /auth/login**\n(username, password, source_ip)
activate A

A -> DB : 2. SELECT user WHERE username
activate DB
DB --> A : user record\n(hash, status)
deactivate DB

A -> A : 3. Argon2id verify\ncredentials valid?

alt credentials INVALID
    A --> U : **401 Invalid credentials**\n(generic error, không leak)
    deactivate A
else credentials VALID + MFA DISABLED
    A -> DB : 4. INSERT session\n+ login_attempt (outcome=success)
    activate DB
    deactivate DB
    A --> U : **200 OK**\n{access_token, refresh_token}
    deactivate A
else credentials VALID + MFA ENABLED
    A -> DB : 5. INSERT pre_auth_transaction\n(status=pending, expires_at+5min)
    activate DB
    deactivate DB
    A --> U : **200 MFA_REQUIRED**\n{mfa_required:true, session_id}
    deactivate A

    == MFA Verify ==

    U -> A : **6. POST /auth/mfa/verify**\n(session_id, mfa_code)
    activate A

    A -> DB : 7. SELECT pre_auth_transaction\nWHERE id=session_id
    activate DB
    DB --> A : transaction record
    deactivate DB

    alt code WRONG / expired / IP mismatch
        A -> DB : 8. UPDATE pre_auth_transaction\n(status=failed)
        activate DB
        deactivate DB
        A --> U : **401 MFA failed**
        deactivate A
    else code VALID
        A -> DB : 8. UPDATE pre_auth_transaction\n(status=completed)\n+ INSERT login_attempt (outcome=mfa_success)\n+ INSERT session
        activate DB
        deactivate DB
        A --> U : **200 OK**\n{access_token, refresh_token}
        deactivate A
    end
end

@enduml
