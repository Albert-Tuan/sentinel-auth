@startuml ERD_Chen_v3.3

!define METADATA /'
================================================================================
ERD v3.3 - Chen's Notation (Peter Chen)
Sentinel Auth - 3 Database Architecture
================================================================================
Legend:
  - Entity: Rectangle (hình chữ nhật)
  - Relationship: Diamond (hình thoi)
  - Attribute: Ellipse (hình oval), PK underlined
  - Cardinality: (min, max) format

Databases:
  1. CORE-DB (core-app): 13 tables
  2. DETECTION-DB (detection-engine): 7 tables
  3. ML-SERVICE-DB (ml-service): 3 tables
'/

' ==============================================================================
' STYLE DEFINITIONS
' ==============================================================================

skinparam rectangle {
    BackgroundColor #White
    BorderColor #333333
    FontSize 11
    FontStyle Bold
}

skinparam diamond {
    BackgroundColor #LightBlue
    BorderColor #333333
    FontSize 10
}

skinparam entity {
    BackgroundColor #LightYellow
    BorderColor #333333
    FontSize 11
}

' ==============================================================================
' CORE-DB SECTION
' ==============================================================================

title **CORE-DB Entities (core-app)**

package "CORE-DB" {

    entity "USER" as user <<Entity>> {
        * id : UUID <<PK>>
        --
        username : TEXT <<UK>>
        password_hash : TEXT
        email : TEXT <<UK>>
        full_name : TEXT
        status : TEXT
        admin_mfa_required : BOOLEAN
        detection_mfa_once : BOOLEAN
        last_login_at : TIMESTAMPTZ
        failed_login_count : INTEGER
        locked_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "ROLE" as role <<Entity>> {
        * id : TEXT <<PK>>
        --
        name : TEXT
        name_vi : TEXT
        description : TEXT
        created_at : TIMESTAMPTZ
    }

    entity "USER_ROLE" as user_role <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        * role_id : TEXT <<FK>>
        assigned_at : TIMESTAMPTZ
        assigned_by : UUID <<FK>>
    }

    entity "IP_ADDRESS" as ip_address <<Entity>> {
        * id : UUID <<PK>>
        --
        * ip_address : INET <<UK>>
        country_code : TEXT
        country_name : TEXT
        is_proxy : BOOLEAN
        is_vpn : BOOLEAN
        is_tor : BOOLEAN
        first_seen_at : TIMESTAMPTZ
        last_seen_at : TIMESTAMPTZ
    }

    entity "SESSION" as session <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        access_token_hash : TEXT
        refresh_token_hash : TEXT
        refresh_token_family : UUID
        token_jti : TEXT <<UK>>
        expires_at : TIMESTAMPTZ
        last_activity_at : TIMESTAMPTZ
        revoked_at : TIMESTAMPTZ
        ip_address_id : UUID <<FK>>
        user_agent : TEXT
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "MFA_TRANSACTION" as mfa_transaction <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        mfa_type : TEXT
        status : TEXT
        bound_ip : INET
        notification_id : UUID <<FK>>
        fail_count : INTEGER
        expires_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "MFA_NOTIFICATION" as mfa_notification <<Entity>> {
        * id : UUID <<PK>>
        --
        * mfa_transaction_id : UUID <<FK>>
        channel : TEXT
        recipient : TEXT
        mfa_code_hash : TEXT
        sent_at : TIMESTAMPTZ
        delivered_at : TIMESTAMPTZ
        failed_at : TIMESTAMPTZ
        failure_reason : TEXT
        expires_at : TIMESTAMPTZ
        verified_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
    }

    entity "AUDIT_LOG" as audit_log <<Entity>> {
        * id : UUID <<PK>>
        --
        request_id : UUID
        actor_id : UUID <<FK>>
        actor_type : TEXT
        action : TEXT
        resource : TEXT
        resource_id : UUID
        before_state : JSONB
        after_state : JSONB
        change_reason : TEXT
        ip_address : INET
        user_agent : TEXT
        created_at : TIMESTAMPTZ
    }

    entity "TRUSTED_DEVICE" as trusted_device <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        * device_fingerprint : TEXT
        device_name : TEXT
        last_ip : INET
        last_user_agent : TEXT
        last_used_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
    }

    entity "SYSTEM_SETTING" as system_setting <<Entity>> {
        * key : TEXT <<PK>>
        --
        value : TEXT
        value_type : TEXT
        description : TEXT
        category : TEXT
        updated_by : UUID <<FK>>
        updated_at : TIMESTAMPTZ
    }

    entity "OUTBOX_EVENT" as outbox_event <<Entity>> {
        * id : UUID <<PK>>
        --
        aggregate_type : TEXT
        aggregate_id : UUID
        event_type : TEXT
        version : INTEGER
        payload : JSONB
        headers : JSONB
        status : TEXT
        retry_count : INTEGER
        max_retries : INTEGER
        last_error : TEXT
        created_at : TIMESTAMPTZ
        published_at : TIMESTAMPTZ
    }

    entity "USER_NOTIFICATION" as user_notification <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        type : TEXT
        title : TEXT
        body : TEXT
        link : TEXT
        priority : TEXT
        read : BOOLEAN
        read_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
    }

    entity "RATE_LIMIT" as rate_limit <<Entity>> {
        * ip_address : INET <<PK>>
        * action : TEXT <<PK>>
        --
        count : INTEGER
        max_count : INTEGER
        window_start : TIMESTAMPTZ
    }

}

' ==============================================================================
' CORE-DB RELATIONSHIPS (Chen Notation)
' ==============================================================================

' User has Roles (M:N via user_role)
user --{ user_role : "HAS"
role --{ user_role : "ASSIGNED_TO"

' User creates Sessions (1:N)
user --{ session : "CREATES"

' Session from IP (N:1, optional)
session }o-- ip_address : "FROM"

' User initiates MFA Transactions (1:N)
user --{ mfa_transaction : "INITIATES"

' MFA Transaction creates Notification (1:1)
mfa_transaction --|| mfa_notification : "CREATES"

' User actions audit logged (1:N)
user --{ audit_log : "ACTIONS_BY"

' User registers Trusted Devices (1:N)
user --{ trusted_device : "REGISTERS"

' User receives Notifications (1:N)
user --{ user_notification : "RECEIVES"

' User updates System Settings (1:N)
user --{ system_setting : "UPDATES"

@enduml

@startuml ERD_Chen_v3.3_detection

title **DETECTION-DB Entities (detection-engine)**

package "DETECTION-DB" {

    entity "POLICY" as policy <<Entity>> {
        * id : UUID <<PK>>
        --
        * version : TEXT <<UK>>
        name : TEXT
        description : TEXT
        rules : JSONB
        config : JSONB
        is_active : BOOLEAN
        created_by : UUID <<FK>>
        created_at : TIMESTAMPTZ
        activated_at : TIMESTAMPTZ
        deactivated_at : TIMESTAMPTZ
    }

    entity "LOGIN_ATTEMPT" as login_attempt <<Entity>> {
        * id : UUID <<PK>>
        --
        * event_id : UUID <<UK>>
        user_id : UUID <<FK>>
        username_attempted : TEXT
        outcome : TEXT
        mfa_used : BOOLEAN
        ip_address : INET
        user_agent : TEXT
        timestamp : TIMESTAMPTZ
        status : TEXT
        policy_id : UUID <<FK>>
        request_id : UUID
        primary_alert_id : UUID <<FK>>
        risk_level : TEXT
        detection_decision : TEXT
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "RISK_ASSESSMENT" as risk_assessment <<Entity>> {
        * id : UUID <<PK>>
        --
        * login_attempt_id : UUID <<FK>>
        policy_id : UUID <<FK>>
        rule_score : NUMERIC
        ml_score : NUMERIC
        combined_score : NUMERIC
        ml_status : TEXT
        ml_model_version : TEXT
        rule_hits : JSONB
        ml_reason_codes : JSONB
        ml_features_used : JSONB
        risk_level : TEXT
        decision : TEXT
        created_at : TIMESTAMPTZ
    }

    entity "DETECTION_LOG" as detection_log <<Entity>> {
        * id : UUID <<PK>>
        --
        login_attempt_id : UUID <<FK>>
        request_id : UUID
        stage : TEXT
        stage_detail : TEXT
        rule_id : UUID
        rule_name : TEXT
        triggered : BOOLEAN
        score_contribution : NUMERIC
        decision : TEXT
        reason : TEXT
        details : JSONB
        created_at : TIMESTAMPTZ
    }

    entity "SOC_ANALYST" as soc_analyst <<Entity>> {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        display_name : TEXT
        is_active : BOOLEAN
        max_alerts : INTEGER
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "ALERT" as alert <<Entity>> {
        * id : UUID <<PK>>
        --
        * login_attempt_id : UUID <<FK>>
        policy_id : UUID <<FK>>
        request_id : UUID
        status : TEXT
        risk_level : TEXT
        detection_reason : TEXT
        detection_scores : JSONB
        assigned_to_id : UUID <<FK>>
        resolved_by_id : UUID <<FK>>
        resolved_at : TIMESTAMPTZ
        resolution : TEXT
        notes : TEXT
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "ALERT_TIMELINE" as alert_timeline <<Entity>> {
        * id : UUID <<PK>>
        --
        * alert_id : UUID <<FK>>
        event_type : TEXT
        actor_id : UUID <<FK>>
        actor_type : TEXT
        old_value : TEXT
        new_value : TEXT
        comment : TEXT
        ip_address : INET
        created_at : TIMESTAMPTZ
    }

}

' ==============================================================================
' DETECTION-DB RELATIONSHIPS (Chen Notation)
' ==============================================================================

' Login Attempt has Risk Assessment (1:1) - UNIQUE constraint
login_attempt --|| risk_assessment : "HAS"

' Login Attempt generates Detection Logs (1:N)
login_attempt --{ detection_log : "GENERATES"

' Login Attempt triggers Alerts (1:N)
login_attempt --{ alert : "TRIGGERS"

' Login Attempt evaluated with Policy (N:1, optional)
login_attempt }o--|| policy : "EVALUATED_WITH"

' Risk Assessment evaluated with Policy (N:1, optional)
risk_assessment }o--|| policy : "EVALUATED_WITH"

' Alert has Policy context (N:1, optional)
alert }o--|| policy : "CONTEXT"

' Alert assigned to SOC Analyst (N:1, optional)
alert }o--|| soc_analyst : "ASSIGNED_TO"

' Alert resolved by SOC Analyst (N:1, optional)
alert }o--|| soc_analyst : "RESOLVED_BY"

' Alert has Timeline (1:N)
alert --{ alert_timeline : "HAS"

' SOC Analyst is User (1:1) - cross-service
soc_analyst --|| user : "IS_ANALYST"

' Login Attempt primary Alert (1:1, optional)
login_attempt --o| alert : "PRIMARY_ALERT"

@enduml

@startuml ERD_Chen_v3.3_ml

title **ML-SERVICE-DB Entities (ml-service)**

package "ML-SERVICE-DB" {

    entity "MODEL_VERSION" as model_version <<Entity>> {
        * id : UUID <<PK>>
        --
        name : TEXT
        * version : TEXT <<UK>>
        algorithm : TEXT
        description : TEXT
        model_path : TEXT
        config : JSONB
        status : TEXT
        is_production : BOOLEAN
        trained_by : UUID <<FK>>
        training_date : TIMESTAMPTZ
        deployed_at : TIMESTAMPTZ
        archived_at : TIMESTAMPTZ
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    entity "INFERENCE_LOG" as inference_log <<Entity>> {
        * id : UUID <<PK>>
        --
        * request_id : UUID <<UK>>
        model_version_id : UUID <<FK>>
        model_version_used : TEXT
        features : JSONB
        raw_score : NUMERIC
        normalized_score : NUMERIC
        is_anomaly : BOOLEAN
        reason_codes : JSONB
        model_status : TEXT
        processing_time_ms : INTEGER
        error_message : TEXT
        ip_address : INET
        created_at : TIMESTAMPTZ
    }

    entity "FEATURE_STATISTIC" as feature_statistic <<Entity>> {
        * id : UUID <<PK>>
        --
        * feature_name : TEXT
        timestamp : TIMESTAMPTZ
        count : BIGINT
        mean : NUMERIC
        std : NUMERIC
        min : NUMERIC
        max : NUMERIC
        p25 : NUMERIC
        p50 : NUMERIC
        p75 : NUMERIC
        p95 : NUMERIC
        anomaly_rate : NUMERIC
        created_at : TIMESTAMPTZ
    }

}

' ==============================================================================
' ML-SERVICE-DB RELATIONSHIPS (Chen Notation)
' ==============================================================================

' Inference Log references Model Version (FK, same DB)
inference_log }o--|| model_version : "REFERENCES"

' Detection Engine calls ML Service (HTTP - no FK relationship shown)
' This is a cross-service call, represented as dashed line

@enduml

@startuml ERD_Chen_v3.3_complete

' ==============================================================================
' COMPLETE ERD - Chen's Notation
' Sentinel Auth v3.3 - 3 Databases
' ==============================================================================

title **Sentinel Auth ERD v3.3 - Chen's Notation\n(Rectangle=Entity, Diamond=Relationship, Oval=Attribute)'

skinparam dpi 120
skinparam shadowing false

' ------------------------------------------------------------------------------
' LEGEND
' ------------------------------------------------------------------------------
legend right
|= Symbol |= Meaning |
| <<Rectangle>> | Entity (Bảng) |
| <<Diamond>> | Relationship (Quan hệ) |
| <<Oval>> | Attribute (Thuộc tính) |
| **Underline** | Primary Key |
| (0,1) | Zero or One |
| (1,1) | Exactly One |
| (0,N) | Zero to Many |
| (1,N) | One to Many |
| -- | Identifying Relationship |
| .. | Non-Identifying Relationship |
endlegend

' ==============================================================================
' CORE-DB: USERS & AUTHENTICATION
' ==============================================================================

rectangle "USER" <<Entity>> #LightYellow {
    (id) "PK"
    (username) "UK"
    (email) "UK"
    (password_hash)
    (full_name)
    (status)
    (admin_mfa_required)
    (detection_mfa_once)
