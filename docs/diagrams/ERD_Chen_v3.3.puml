    (name_vi)
    (description)
    (created_at)
}

rectangle "USER_ROLE" <<Entity>> #LightYellow {
    (id) "PK"
    (user_id) "FK"
    (role_id) "FK"
    (assigned_at)
    (assigned_by) "FK"
}

rectangle "SESSION" <<Entity>> #LightYellow {
    (id) "PK"
