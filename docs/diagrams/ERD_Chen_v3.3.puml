' ------------------------------------------------------------------------------
' CORE-DB RELATIONSHIPS
' ------------------------------------------------------------------------------

USER }o--o{ USER_ROLE : "(1,N)"
ROLE }o--o{ USER_ROLE : "(1,N)"
USER_ROLE }o--|| USER : "(0,1)"

USER --{ SESSION : "(1,N)"
SESSION }o--|| IP_ADDRESS : "(0,1)"

USER --{ MFA_TRANSACTION : "(1,N)"
MFA_TRANSACTION --|| MFA_NOTIFICATION : "(1,1)"

USER --o{ SYSTEM_SETTING : "(0,N)"

