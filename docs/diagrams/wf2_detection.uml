@startuml
skinparam backgroundColor #FFFFFF

title WF-2: Detection Inline (Risk Assessment)

participant "Auth API" as A #DAE8FC
participant "Detection\nService" as D #FFF2CC
participant "ML Scoring\n(Isolation Forest)" as ML #E1D5E7
participant "PostgreSQL" as DB #F5F5F5

note over A
  Sau khi login thành công (WF-1)
  → gọi /internal/v1/detect
end note

A -> D : **1. POST /internal/v1/detect**\n(login_attempt_id, user_id, source_ip,\nuser_agent, timestamp...)
activate D

D -> DB : 2. SELECT user history\n(fail_count_24h, known_devices,\nlast_login_ip, last_login_time...)
activate DB
DB --> D : user context
deactivate DB

D -> D : 3. Trích features\n(IP mới? | Fail > 3? | Giờ lạ?\n| Device mới? | Geo distance?)
activate D
deactivate D

D -> D : 4. Tính rule_score (0.0 – 1.0)\nDựa trên rule engine
activate D
deactivate D

D -> ML : **5. POST /internal/v1/ml/score**\n(features_vector)
activate ML

alt ML available
    ML -> ML : 6. Isolation Forest\npredict() [timeout 500ms]
    ML --> D : {anomaly_score,\nis_anomaly,\nreason_codes}
    deactivate ML
else ML timeout / error
    ML --> D : error / timeout
    note right: ml_status=error\n→ risk_level=medium\n(fallback)
    deactivate ML
end

D -> D : 7. risk = combine(rule_score,\nanomaly_score)\n→ risk_level
activate D
deactivate D

D -> DB : 8. INSERT risk_assessment\n(rule_score, anomaly_score,\nml_status, risk_level)\n**luôn lưu**
activate DB
deactivate DB

alt risk_level HIGH hoặc CRITICAL
    D -> DB : 9. INSERT alert\n(status=open, risk_level)
    activate DB
    deactivate DB
    D --> A : **200** {alert_created: true,\nrisk_level}
else risk_level LOW hoặc MEDIUM
    D --> A : **200** {alert_created: false,\nrisk_level}
end

@enduml
