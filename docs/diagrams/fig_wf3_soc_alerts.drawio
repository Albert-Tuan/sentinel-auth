<mxfile>
  <diagram name="WF-3: SOC Alerts">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="WF-3: SOC — Xem và xử lý Alert" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="260" y="10" width="400" height="35" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll1_box" value="SOC Analyst&#xa;(Browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll1_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#17A2B8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="100" as="sourcePoint"/>
            <mxPoint x="90" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ll2_box" value="Auth API&#xa;(SOC endpoints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll2_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#6C8EBF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="100" as="sourcePoint"/>
            <mxPoint x="280" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ll3_box" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll3_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="495" y="100" as="sourcePoint"/>
            <mxPoint x="495" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Section: List alerts -->
        <mxCell id="sec1" value="─── List Alerts ───" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#17A2B8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="105" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Step 1: GET alerts -->
        <mxCell id="s1_box" value="1. GET /api/v1/alerts&#xa;?status=open&#xa;&amp;risk_level=high" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s1_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="167" as="sourcePoint"/>
            <mxPoint x="220" y="167" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Query -->
        <mxCell id="s2_box" value="2. SELECT alerts&#xa;WHERE status=?&#xa;AND risk_level=?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s2_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="167" as="sourcePoint"/>
            <mxPoint x="440" y="167" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Return list -->
        <mxCell id="s3_box" value="3. {alerts: [&#xa;  {id, risk_level,&#xa;  user_id, created_at...}&#xa;]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#17A2B8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="245" as="sourcePoint"/>
            <mxPoint x="220" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Section: Get detail -->
        <mxCell id="sec2" value="─── Alert Detail ───" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#17A2B8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="305" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Step 4: GET detail -->
        <mxCell id="s4_box" value="4. GET /alerts/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s4_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="360" as="sourcePoint"/>
            <mxPoint x="220" y="360" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 5: Query detail -->
        <mxCell id="s5_box" value="5. SELECT alert +&#xa;login_attempt info" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s5_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="362" as="sourcePoint"/>
            <mxPoint x="440" y="362" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: Return detail -->
        <mxCell id="s6_box" value="6. {alert +&#xa;login_attempt detail}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="405" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s6_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#17A2B8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="425" as="sourcePoint"/>
            <mxPoint x="220" y="425" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Section: Handle alert -->
        <mxCell id="sec3" value="─── Handle Alert (Acknowledge / Resolve) ───" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#17A2B8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="470" width="340" height="25" as="geometry"/>
        </mxCell>

        <!-- PATCH alert -->
        <mxCell id="s7_box" value="7. PATCH /alerts/{id}&#xa;{status, notes,&#xa;resolved_by?}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#17A2B8;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="505" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s7_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="532" as="sourcePoint"/>
            <mxPoint x="220" y="532" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Update DB -->
        <mxCell id="s8_box" value="8. UPDATE alert&#xa;(status, assigned_to,&#xa;resolved_by, resolved_at)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="505" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s8_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="532" as="sourcePoint"/>
            <mxPoint x="440" y="532" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Response -->
        <mxCell id="s9_box" value="9. {alert: {status: acknowledged hoặc resolved...}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s9_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82B366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="605" as="sourcePoint"/>
            <mxPoint x="220" y="605" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Alert state machine -->
        <mxCell id="state_title" value="Alert State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#2C3E50;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="105" width="150" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="state1" value="open" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#CC0000;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="145" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="state2" value="acknowledged" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="210" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="state3" value="resolved" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="275" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="state4" value="false_positive" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="340" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="state_a1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="185" as="sourcePoint"/>
            <mxPoint x="700" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="state_a1_l" value="acknowledge" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="710" y="192" width="80" height="15" as="geometry"/>
        </mxCell>

        <mxCell id="state_a2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="250" as="sourcePoint"/>
            <mxPoint x="700" y="275" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="state_a2_l" value="resolve" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="710" y="257" width="60" height="15" as="geometry"/>
        </mxCell>

        <mxCell id="state_a3" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#9673A6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="250" as="sourcePoint"/>
            <mxPoint x="700" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="state_a3_l" value="mark false positive" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="700" y="295" width="100" height="15" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
