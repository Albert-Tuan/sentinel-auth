@startuml
skinparam backgroundColor #FFFFFF
skinparam rectangle<<wf>> {
    BackgroundColor #F0F8FF
    BorderColor #6C8EBF
    FontStyle bold
}

title Sentinel Auth — 3 Workflow Architecture

package "WF-1: Auth" <<wf>> {
    rectangle "User\n(Browser)" as U #D5E8D4
    rectangle "POST /auth/login\n(username, password, ip)" as LOGIN #FFF2CC
    rectangle "Auth API\n(Argon2id verify)" as AUTH #DAE8FC
    rectangle "PostgreSQL\n(users, sessions,\npre_auth_tx)" as DB1 #F5F5F5
    rectangle "MFA?\n(optional)" as MFA #FFE6CC
    rectangle "access_token\nrefresh_token" as TOKEN #D5E8D4
}

package "WF-2: Detection (Inline)" <<wf>> {
    rectangle "Auth API\n(gọi sau login)" as AUTH2 #DAE8FC
    rectangle "POST /internal/v1/detect\n(features: IP, fail_count,\ndevice, time...)" as DETECT #FFF2CC
    rectangle "ML Scoring\n(Isolation Forest)" as ML #E1D5E7
    rectangle "anomaly_score (0..1)" as SCORE #E1D5E7
    rectangle "risk_assessments\n+ alerts" as DB2 #F5F5F5
    rectangle "HIGH/CRITICAL\n→ tạo alert?" as RISK #FFE6CC
}

package "WF-3: SOC Alerts" <<wf>> {
    rectangle "SOC Analyst\n(Browser)" as SOC #CCE5FF
    rectangle "GET /api/v1/alerts\n(filter: status, risk)" as GET #FFF2CC
    rectangle "PATCH /alerts/{id}\n(acknowledge/resolve)" as PATCH #FFF2CC
    rectangle "Auth API" as AUTH3 #DAE8FC
    rectangle "alerts\n(status, notes)" as DB3 #F5F5F5
}

' Internal arrows
AUTH -[#82B366,bold]-> TOKEN : access_token
TOKEN -[#82B366,dashed,bold]-> AUTH2 : access_token
AUTH2 -[#333]-> DETECT
DETECT -[#333]-> ML
ML -[#9673A6]-> RISK
RISK -[#D6A656,dashed,bold]-> DB2 : alert
ML -[#9673A6,dashed]-> SCORE

legend right
|= Color |= Meaning |
| <back:#FFF2CC>    </back> | HTTP Request |
| <back:#DAE8FC>    </back> | API / Service |
| <back:#E1D5E7>    </back> | ML Component |
| <back:#F5F5F5>    </back> | Database |
| <back:#FFE6CC>    </back> | Decision |
| <back:#D5E8D4>    </back> | Success/Token |
| <back:#CCE5FF>    </back> | SOC Actor |
endlegend

note bottom of diagram
**Tech Stack:**
FastAPI + PostgreSQL (1 schema) + Argon2id
No Redis • No background worker
Detection chạy inline trong request
end note

@enduml
