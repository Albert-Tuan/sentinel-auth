@startuml SentinelAuth-ERD-v3

!theme plain
skinparam linetype ortho
skinparam dpi 150

' =============================================================================
' SENTINEL AUTH - Entity Relationship Diagram v3
' Based on: infra/postgres/schema-v3.sql
' NEW: 5 additional tables from schema v2
' =============================================================================

' --------------------- ENTITIES ---------------------

' --- CORE ---
entity "roles" as roles <<REFERENCE TABLE>> {
    * id : TEXT (PK)
    --
    name : TEXT
    description : TEXT
    created_at : TIMESTAMPTZ
}

entity "users" as users <<CORE>> {
    * id : UUID (PK)
    --
    username : TEXT (UNIQUE)
    password_hash : TEXT
    email : TEXT
    full_name : TEXT
    status : TEXT
    admin_mfa_required : BOOLEAN
    detection_mfa_once : BOOLEAN
    last_login_at : TIMESTAMPTZ
    failed_login_count : INTEGER
    locked_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "user_roles" as user_roles <<JUNCTION>> {
    * user_id : UUID (FK)
    * role_id : TEXT (FK)
    --
    assigned_at : TIMESTAMPTZ
    assigned_by : UUID (FK)
}

' --- AUTH ---
entity "sessions" as sessions <<SESSION>> {
    * id : UUID (PK)
    --
    user_id : UUID (FK)
    access_token_hash : TEXT
    refresh_token_hash : TEXT
    refresh_token_family : UUID
    token_jti : TEXT (UNIQUE)
    expires_at : TIMESTAMPTZ
    last_activity_at : TIMESTAMPTZ
    revoked_at : TIMESTAMPTZ
    ip_address : INET
    user_agent : TEXT
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "pre_auth_transactions" as pre_auth <<MFA>> {
    * id : UUID (PK)
    --
    user_id : UUID (FK)
    mfa_type : TEXT
    expires_at : TIMESTAMPTZ
    status : TEXT
    bound_ip : TEXT
    notification_id : UUID (FK)
    fail_count : INTEGER
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "mfa_notifications" as mfa_notif <<MFA>> {
    * id : UUID (PK)
    --
    pre_auth_transaction_id : UUID (FK)
    channel : TEXT
    recipient : TEXT
    mfa_code_hash : TEXT
    sent_at : TIMESTAMPTZ
    delivered_at : TIMESTAMPTZ
    failed_at : TIMESTAMPTZ
    failure_reason : TEXT
    expires_at : TIMESTAMPTZ
    verified_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

' --- v3: Trusted Devices ---
entity "user_trusted_devices" as trusted_dev <<NEW v3>> {
    * id : UUID (PK)
    --
    user_id : UUID (FK)
    device_fingerprint : TEXT
    device_name : TEXT
    last_ip : INET
    last_user_agent : TEXT
    last_used_at : TIMESTAMPTZ
    expires_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

' --- DETECTION ---
entity "policy_versions" as policies <<POLICY>> {
    * id : UUID (PK)
    --
    version : TEXT (UNIQUE)
    description : TEXT
    rules_json : JSONB
    weights : JSONB
    thresholds : JSONB
    is_active : BOOLEAN
    created_by_user_id : UUID (FK)
    created_at : TIMESTAMPTZ
    activated_at : TIMESTAMPTZ
    deactivated_at : TIMESTAMPTZ
}

entity "login_attempts" as login_attempts <<AUDIT>> {
    * id : UUID (PK)
    --
    user_id : UUID (FK)
    username_attempted : TEXT
    occurred_at : TIMESTAMPTZ
    outcome : TEXT
    source_ip : INET
    user_agent : TEXT
    rate_limited : BOOLEAN
    policy_version_id : UUID (FK)
    request_id : UUID
    detection_features : JSONB
    primary_alert_id : UUID (FK)
    risk_level : TEXT
    mfa_used : BOOLEAN
    detection_decision : TEXT
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "risk_assessments" as risk <<RISK>> {
    * id : UUID (PK)
    --
    login_attempt_id : UUID (FK) <<UNIQUE>>
    policy_version_id : UUID (FK)
    rule_score : NUMERIC(5,4)
    anomaly_score : NUMERIC(5,4)
    ml_score : NUMERIC(5,4)
    ml_status : TEXT
    ml_model_version : TEXT
    rule_hits : JSONB
    ml_features_used : JSONB
    combined_score : NUMERIC(5,4)
    risk_level : TEXT
    decision : TEXT
    created_at : TIMESTAMPTZ
}

entity "detection_logs" as detection_logs <<AUDIT>> {
    * id : UUID (PK)
    --
    login_attempt_id : UUID (FK)
    request_id : UUID
    stage : TEXT
    stage_detail : TEXT
    rule_id : UUID
    rule_name : TEXT
    score : NUMERIC(5,4)
    decision : TEXT
    reason : TEXT
    details : JSONB
    created_at : TIMESTAMPTZ
}

' --- SOC ---
entity "alerts" as alerts <<SOC>> {
    * id : UUID (PK)
    --
    login_attempt_id : UUID (FK)
    policy_version_id : UUID (FK)
    request_id : UUID
    status : TEXT
    risk_level : TEXT
    detection_reason : TEXT
    detection_scores : JSONB
    assigned_to : TEXT
    resolved_by : TEXT
    resolved_at : TIMESTAMPTZ
    notes : TEXT
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

' --- v3: Alert Timeline ---
entity "alert_timeline" as alert_timeline <<NEW v3>> {
    * id : UUID (PK)
    --
    alert_id : UUID (FK)
    event_type : TEXT
    actor : TEXT
    old_value : TEXT
    new_value : TEXT
    comment : TEXT
    ip_address : INET
    created_at : TIMESTAMPTZ
}

' --- OPERATIONAL ---
entity "rate_limits" as rate_limits <<OPERATIONAL>> {
    * ip_address : INET (PK)
    * action : TEXT (PK)
    --
    count : INTEGER
    max_count : INTEGER
    window_start : TIMESTAMPTZ
}

entity "audit_logs" as audit_logs <<AUDIT>> {
    * id : UUID (PK)
    --
    request_id : UUID
    actor : TEXT
    action : TEXT
    resource : TEXT
    resource_id : UUID
    before_state : JSONB
    after_state : JSONB
    change_reason : TEXT
    ip_address : INET
    user_agent : TEXT
    created_at : TIMESTAMPTZ
}

' --- v3: System Settings ---
entity "system_settings" as sys_settings <<NEW v3>> {
    * key : TEXT (PK)
    --
    value : TEXT
    value_type : TEXT
    description : TEXT
    category : TEXT
    updated_by : UUID (FK)
    updated_at : TIMESTAMPTZ
}

' --- v3: Outbox Events ---
entity "outbox_events" as outbox <<NEW v3>> {
    * id : UUID (PK)
    --
    aggregate_type : TEXT
    aggregate_id : UUID
    event_type : TEXT
    version : INTEGER
    payload : JSONB
    headers : JSONB
    status : TEXT
    retry_count : INTEGER
    max_retries : INTEGER
    last_error : TEXT
    created_at : TIMESTAMPTZ
    published_at : TIMESTAMPTZ
}

' --- v3: User Notifications ---
entity "user_notifications" as user_notif <<NEW v3>> {
    * id : UUID (PK)
    --
    user_id : UUID (FK)
    type : TEXT
    title : TEXT
    body : TEXT
    link : TEXT
    priority : TEXT
    read : BOOLEAN
    read_at : TIMESTAMPTZ
    expires_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

' =============================================================================
' RELATIONSHIPS
' =============================================================================

' --- CORE ---
users ||--o{ user_roles : "has"
roles ||--o{ user_roles : "assigned"
users ||--o{ sessions : "owns"
users ||--o{ pre_auth : "initiates"
users ||--o{ policies : "creates"
users ||--o{ login_attempts : "performs"
users ||--o{ trusted_dev : "registers device"
users ||--o{ user_notif : "receives"
users ||--o{ sys_settings : "updates"

' --- AUTH ---
pre_auth ||--|| mfa_notif : "creates"

' --- DETECTION ---
login_attempts ||--|| risk : "evaluated by"
login_attempts ||--o{ detection_logs : "generates"
login_attempts ||--o{ alerts : "triggers"
policies ||--o{ login_attempts : "applied to"
policies ||--o{ risk : "used in"
policies ||--o{ alerts : "context for"

' --- SOC ---
alerts ||--o{ alert_timeline : "has timeline"

' =============================================================================
' LEGEND
' =============================================================================

legend right
  |= Symbol |= Meaning |
  |= PK |= Primary Key |
  |= FK |= Foreign Key |
  |= (UNIQUE) |= Unique Constraint |
  |= ||--o{ |= One-to-Many |
  ||= ||--||= One-to-One |
  |= NEW v3 |= New table in Schema v3 |
endlegend

@enduml
