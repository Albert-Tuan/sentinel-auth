<mxfile>
  <diagram name="WF-2: Detection">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="WF-2: Detection Inline (Risk Assessment)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="440" height="35" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll1_box" value="Auth API&#xa;(gọi sau login)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll1_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#6C8EBF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="100" as="sourcePoint"/>
            <mxPoint x="115" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ll2_box" value="Detection&#xa;Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll2_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#D6A656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="100" as="sourcePoint"/>
            <mxPoint x="305" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ll3_box" value="ML Scoring&#xa;(Isolation Forest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll3_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#9673A6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="100" as="sourcePoint"/>
            <mxPoint x="520" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ll4_box" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ll4_line" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="100" as="sourcePoint"/>
            <mxPoint x="735" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 1: Trigger detect -->
        <mxCell id="s1_box" value="1. POST /internal/v1/detect&#xa;(login_attempt_id, user_id,&#xa;source_ip, user_agent...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s1_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="137" as="sourcePoint"/>
            <mxPoint x="250" y="137" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Query user history -->
        <mxCell id="s2_box" value="2. SELECT user history&#xa;(fail_count_24h,&#xa;known_devices,&#xa;last_login_ip...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s2_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="137" as="sourcePoint"/>
            <mxPoint x="680" y="137" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2_ret" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#D6A656;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="180" as="sourcePoint"/>
            <mxPoint x="305" y="180" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2_ret_label" value="user context" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="455" y="175" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 3: Feature extraction -->
        <mxCell id="s3_box" value="3. Trích features&#xa;(IP mới? | Fail > 3? |&#xa;Giờ lạ? | Device mới?)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="195" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s3_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#D6A656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="222" as="sourcePoint"/>
            <mxPoint x="305" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Rule scoring -->
        <mxCell id="s4_box" value="4. Tính rule_score&#xa;(0.0 – 1.0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="265" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s4_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#D6A656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="275" as="sourcePoint"/>
            <mxPoint x="305" y="280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 5: Call ML -->
        <mxCell id="s5_box" value="5. POST /internal/v1/ml/score&#xa;(features_vector)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="325" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s5_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="345" as="sourcePoint"/>
            <mxPoint x="460" y="345" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: ML compute -->
        <mxCell id="s6_box" value="6. Isolation Forest&#xa;predict()&#xa;(timeout: 500ms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="325" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s6_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#9673A6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="370" as="sourcePoint"/>
            <mxPoint x="520" y="350" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 7: ML response -->
        <mxCell id="s7_box" value="7. {anomaly_score,&#xa;is_anomaly, reason_codes}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="385" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s7_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673A6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="405" as="sourcePoint"/>
            <mxPoint x="460" y="405" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 8: Aggregate risk -->
        <mxCell id="s8_box" value="8. risk = combine(&#xa;rule_score, anomaly_score)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="445" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s8_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#D6A656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="455" as="sourcePoint"/>
            <mxPoint x="305" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Decision diamond -->
        <mxCell id="dec1" value="risk_level&#xa;HIGH /&#xa;CRITICAL?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="505" width="110" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="dec1_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="500" as="sourcePoint"/>
            <mxPoint x="305" y="505" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 9: Insert risk assessment -->
        <mxCell id="s9_box" value="9. INSERT&#xa;risk_assessment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="525" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s9_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="545" as="sourcePoint"/>
            <mxPoint x="680" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="s9_label" value="luôn lưu" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="515" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 10: Create alert -->
        <mxCell id="s10_box" value="10. INSERT alert&#xa;(status=open)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#CC0000;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="585" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s10_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#CC0000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="590" as="sourcePoint"/>
            <mxPoint x="510" y="590" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="s10_label" value="YES → alert" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#CC0000;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="570" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 11: Return -->
        <mxCell id="s11_box" value="11. {alert_created: true,&#xa;risk_level: high}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s11_arrow" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82B366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="620" as="sourcePoint"/>
            <mxPoint x="250" y="620" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- NO branch -->
        <mxCell id="no_label" value="NO → 200 OK&#xa;no alert" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#888;" vertex="1" parent="1">
          <mxGeometry x="10" y="530" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="no_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="542" as="sourcePoint"/>
            <mxPoint x="110" y="542" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ML failure branch -->
        <mxCell id="ml_fail" value="ML unavailable?&#xa;→ ml_status=error&#xa;→ risk_level=medium" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#CC6600;align=center;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="580" y="310" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ml_fail_arrow" value="" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="380" as="sourcePoint"/>
            <mxPoint x="610" y="385" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ml_fail_note" value="fallback" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#CC6600;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="340" width="60" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
