@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam ArrowColor black
skinparam ArrowThickness 1.2
title WF-1  Login Flow (updated 2026-10-05)

actor "User" as user

rectangle "Core App" as sys_1 {
  rectangle "Login request" as request
  rectangle "Password and account check" as check
  rectangle "Record login attempt" as attempt
  rectangle "Risk Gate\n(pre-token-check)" as gate #FF6B6B
  rectangle "Create MFA challenge" as mfa
  rectangle "Verify MFA code" as verify
  rectangle "Create session and tokens" as session
}

rectangle "Detection Engine" as sys_3 {
  rectangle "pre-token-check handler" as ptc
}

rectangle "core-db" as sys_2 {
  rectangle "Find user" as find
  rectangle "Record outcome" as stored_attempt
  rectangle "mfa_transaction pending" as tx
  rectangle "Store session" as stored
}

user --> request : credentials\n<<flow>>
request --> find : SELECT user\n<<flow>>
find --> check : user record\n<<flow>>
check --> user : 401 / 403 if invalid\n<<flow>>

' If valid credentials
check --> attempt : eval outcome\n<<flow>>
attempt --> stored_attempt : INSERT login_attempt\n<<flow>>

' Risk gate BEFORE token exists (2026-10-05)
gate --> ptc : POST /internal/pre-token-check\ntimeout 3s\n<<flow>>
ptc --> gate : {risk_level, require_mfa, degraded}\n<<flow>>

' low / medium / degraded → allow, create session
gate --> session : low / medium\n<<flow>>
check --> gate : valid credentials\n<<flow>>

' high / critical → require MFA, no session yet
gate --> mfa : require_mfa = true\n<<flow>>

' MFA branch
mfa --> tx : INSERT pending\n<<flow>>
mfa --> user : 200 MFA_REQUIRED\n<<flow>>

' User provides MFA code
user --> verify : code after MFA_REQUIRED\n<<flow>>
verify --> tx : SELECT transaction\n<<flow>>
verify --> user : 401 if invalid\n<<flow>>

' On valid MFA, create session
verify --> session : valid code\n<<flow>>

' Create session
session --> stored : INSERT session\n<<flow>>
stored --> user : access + refresh tokens\n<<flow>>

legend bottom
  **2026-10-05 changes:**
  - Core App calls /internal/pre-token-check SYNCHRONOUSLY before creating a session
  - HIGH/CRITICAL: token HELD, user must pass MFA first
  - LOW/MEDIUM: token issued immediately
  - FAIL OPEN: error/timeout → allow login, log warning
  - Login response is no longer fully independent of detection
  - Detection Engine calls back /internal/actions after scoring (see WF-2)
endlegend
@enduml
