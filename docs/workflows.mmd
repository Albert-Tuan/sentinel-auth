## Tổng quan kiến trúc

```mermaid
flowchart LR
    subgraph Auth["WF-1: Auth + WF-5: Sessions"]
        L["POST /auth/login"] --> MFA{"MFA?"}
        MFA --> |yes| V["POST /auth/mfa/verify"]
        MFA --> |no| S["Session → Token"]
        V --> S
        S --> R["POST /auth/refresh"]
        S --> O["POST /auth/logout"]
    end

    subgraph MFA["WF-4: MFA Flow"]
        V --> MT["MFA Types"]
        MT --> |email| E["Email OTP"]
        MT --> |sms| SM["SMS OTP"]
        MT --> |totp| T["TOTP Authenticator"]
        MT --> |push| P["Push Notification"]
    end

    subgraph Detect["WF-2: Detection"]
        S --> D["POST /internal/v1/detect"]
        D --> F["Trích features"]
        F --> ML["POST /internal/v1/ml/score"]
        ML --> AL{"Alert?"}
        AL --> |high/critical| A["INSERT alert"]
        AL --> |low/medium| OK["Không alert"]
    end

    subgraph SOC["WF-3: SOC"]
        A --> SOC["GET /alerts"]
        SOC --> ACK["PATCH /alerts/{id}"]
        SOC --> RES["PATCH /alerts/{id} (resolve)"]
    end

    style Auth fill:#d4edda,stroke:#28a745
    style MFA fill:#e1d5e7,stroke:#9673a6
    style Detect fill:#fff3cd,stroke:#ffc107
    style SOC fill:#cce5ff,stroke:#17a2b8
```

