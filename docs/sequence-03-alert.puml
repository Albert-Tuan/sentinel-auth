@startuml st03-asynchronous-detection-and-action
participant "outbox publisher" as publisher
queue "Redis Stream" as stream
participant "detection-engine" as detection
participant "ml-service" as ml
database "detection_engine" as detdb
participant "core-app\nEnforcement" as core
actor "SOC Analyst" as soc

publisher -> stream : publish auth.login-attempt.v1(event_id)
stream -> detection : deliver event
detection -> detdb : deduplicate event_id\nstore LoginAttemptProjection
detection -> detection : evaluate versioned rules\nbuild FeatureVector v1
detection -> ml : POST /internal/v1/ml/score\nworkload token + correlation ID
ml -> ml : verify ACTIVE approval, artifact SHA-256\nfeature schema/order and calibration
ml --> detection : 200 SCORED(inference ID, calibrated score,\nmodel/artifact identity, heuristic reason codes)
detection -> detdb : save RiskAssessment\n(rule/policy/model versions)
alt risk at or above alert threshold
  detection -> detdb : create one active Alert
  detection --> soc : dashboard / notification
  opt action policy permits response
    detection -> core : ActionRequest + scope + expiry\n+ idempotency key
    core -> core : validate identity, policy and approval
    core --> detection : APPLIED | PENDING_APPROVAL | REJECTED
  end
end
@enduml
