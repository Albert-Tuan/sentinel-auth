@startuml use-case-tong-quat
left to right direction
skinparam actorStyle awesome
actor User
actor "SOC Analyst" as SOC
actor "Security Admin" as Admin
actor "Security Manager" as Manager
actor "Email / Telegram" as Channel
rectangle "Sentinel Auth" {
  usecase "Authenticate\nUC-01, UC-02" as auth
  usecase "Self-service security\nUC-03..05" as self
  usecase "SOC investigation\nUC-06..12" as soc
  usecase "Security administration\nUC-13..19" as admin
  usecase "Management reporting\nUC-20..21" as manager
  usecase "Asynchronous assessment\nUC-22..25" as assess
  usecase "Notification\nUC-26" as notify
}
User --> auth
User --> self
SOC --> soc
Admin --> admin
Manager --> manager
Channel --> notify
auth ..> assess : login event published after decision
assess ..> notify : <<extend>>\n[alert channel configured]
@enduml
