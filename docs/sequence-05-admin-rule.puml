@startuml st05-versioned-rule-change
actor "Security Admin" as admin
actor "Security Manager" as manager
participant "Admin UI" as ui
participant "detection-engine" as detection
database "detection_engine" as db

admin -> ui : propose RuleSet change
ui -> detection : POST rule-set versions
detection -> detection : validate rules, thresholds and effective_at
detection -> db : save CANDIDATE version + audit event
alt high-impact change requires approval
  manager -> ui : approve candidate
  ui -> detection : approve version
end
detection -> db : mark APPROVED version active at effective_at
detection --> ui : immutable version id and rollback target
note right of db
Existing assessments retain their
original rule-set version.
end note
@enduml
