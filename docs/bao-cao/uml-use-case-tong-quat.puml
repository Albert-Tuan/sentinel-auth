@startuml
' Sơ đồ Use Case tổng quát - Sentinel Auth v3.3
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Sans
skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #495057
}
skinparam ArrowColor #343A40
skinparam ArrowThickness 1.1
skinparam titleFontSize 17
skinparam usecaseFontSize 10
skinparam ActorFontSize 11
skinparam packageStyle rectangle

title Sơ đồ Use Case tổng quát - Hệ thống cảnh báo đăng nhập bất thường

actor "Người dùng" as User
actor "SOC Analyst" as SOC
actor "Security Admin" as Admin
actor "Security Manager" as Manager
actor "Detection Engine" as DE
actor "ML Service" as ML

rectangle "Sentinel Auth" {
  usecase "UC-01 Đăng nhập" as UC01
  usecase "UC-02 Xác thực MFA" as UC02
  usecase "UC-03 Quản lý phiên\ncá nhân" as UC03
  usecase "UC-04 Tin cậy thiết bị" as UC04

  usecase "UC-05 Kiểm duyệt rủi ro\ntrước khi cấp token" as UC05
  usecase "UC-06 Ghi sự kiện đăng nhập" as UC06
  usecase "UC-07 Chấm điểm rủi ro" as UC07
  usecase "UC-08 Gọi suy luận ML" as UC08
  usecase "UC-09 Tạo cảnh báo SOC" as UC09
  usecase "UC-10 Thực thi hành động\nbảo vệ" as UC10
  usecase "UC-11 Khôi phục attempt lỗi" as UC11

  usecase "UC-12 Xem danh sách cảnh báo" as UC12
  usecase "UC-13 Xem hồ sơ điều tra" as UC13
  usecase "UC-14 Tiếp nhận cảnh báo" as UC14
  usecase "UC-15 Kết luận / Báo nhầm" as UC15
  usecase "UC-16 Chuyển cấp cảnh báo" as UC16
  usecase "UC-17 Xem dòng thời gian" as UC17
  usecase "UC-18 Thực hiện hành động\nbảo vệ" as UC18
  usecase "UC-19 Xem bảng điều khiển SOC" as UC19

  usecase "UC-20 Quản lý chính sách" as UC20
  usecase "UC-21 Quản lý tài khoản, vai trò" as UC21
  usecase "UC-22 Quản lý phiên người dùng khác" as UC22
  usecase "UC-23 Xem nhật ký kiểm toán" as UC23
  usecase "UC-25 Xuất báo cáo tổng hợp" as UC25
}

' FUTURE ENHANCEMENT package — not v3.3 scope
package "FUTURE ENHANCEMENT (không thuộc v3.3)" {
  usecase "UC-24 Phê duyệt leo thang" as UC24
}

' --- Người dùng ---
User --> UC01
User --> UC02
User --> UC03
User --> UC04

' --- SOC Analyst ---
SOC --> UC12
SOC --> UC13
SOC --> UC14
SOC --> UC15
SOC --> UC16
SOC --> UC17
SOC --> UC18
SOC --> UC19

' --- Security Admin ---
Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC23
Admin --> UC12
Admin --> UC13
Admin --> UC18

' --- Security Manager ---
Manager --> UC19
Manager --> UC25
Manager --> UC20
Manager --> UC12
Manager --> UC23
note right #DDD of Manager
  Security Manager: oversight / governance
  - UC-19: view dashboard
  - UC-20 <<view only>>: view policies
  - UC-25: view reports
  - UC-18: supervisory capability (optional)
end note

' --- System actors ---
DE --> UC06
DE --> UC07
DE --> UC09
DE --> UC10
DE --> UC11
ML --> UC08

' --- Quan hệ include ---
UC01 ..> UC05 : <<include>>
UC01 ..> UC06 : <<include>>
UC05 ..> UC07 : <<include>>
UC07 ..> UC08 : <<include>>
UC14 ..> UC17 : <<include>>
UC15 ..> UC17 : <<include>>

' --- Quan hệ extend ---
UC02 ..> UC01 : <<extend>>\n(khi risk cao)
UC16 ..> UC14 : <<extend>>\n(sau khi tiếp nhận)
UC18 ..> UC14 : <<extend>>\n(cần tiếp nhận trước)
UC04 ..> UC02 : <<extend>>\n(sau khi xác thực)

legend bottom
  **Quy ước:**
  - `<<include>>`: hành vi bắt buộc, luôn chạy
  - `<<extend>>`: hành vi tùy chọn, chỉ chạy trong điều kiện riêng

  **Điểm thiết kế quan trọng:**
  - UC-05 (risk gate) được `include` vào UC-01: cổng kiểm duyệt
    luôn nằm sau xác thực mật khẩu và trước khi tạo session
  - UC-08 chỉ là hợp đồng HTTP, không có người dùng trực tiếp
  - UC-10 là đường gọi ngược từ Detection về Core App
endlegend

@enduml
