# ---------------------------------------------------------------------------
# Sentinel Auth frontend — environment configuration
# ---------------------------------------------------------------------------
# Everything prefixed with VITE_ is inlined into the browser bundle.
# NEVER put a server-side secret here: no INTERNAL_SECRET, no database
# credentials, no ML service credentials, no signing secrets.
# ---------------------------------------------------------------------------

# --- Development connection mode -------------------------------------------
# Pick ONE. Do not configure both.
#
# Mode A — Vite proxy (recommended, the default):
#   Leave VITE_API_BASE_URL EMPTY. The browser then calls the API on its own
#   origin and the Vite dev server forwards /api to VITE_DEV_API_TARGET.
#   No CORS is involved at all.
VITE_API_BASE_URL=

# The backend the dev proxy forwards to (development only).
VITE_DEV_API_TARGET=http://localhost:8000

# The port the Vite dev server listens on. It must match the origin added to
# the backend's CORS_ALLOWED_ORIGINS when mode B is used.
VITE_DEV_PORT=5173

# --- Mode B — direct CORS ---------------------------------------------------
# To use direct cross-origin requests instead of the proxy, set the base URL
# to the API origin AND add the Vite origin to the backend's allow-list:
#
#   VITE_API_BASE_URL=http://localhost:8000
#
# and in the backend .env:
#   CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
#
# The backend refuses a wildcard origin and rejects any entry that is not a
# full origin (scheme://host[:port]).
