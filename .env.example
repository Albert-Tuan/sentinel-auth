DETECTION_ENGINE_PORT=8002
ML_SERVICE_PORT=8003
INTERNAL_DEV_TOKEN=replace-with-a-long-random-local-token
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-local-jwt-secret
