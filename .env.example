# Sentinel Auth v3.3 — Environment Variables Template
#
# Copy this file to .env and fill in development secrets.
# .env is gitignored. .env.example is tracked.
#
# =============================================================================
# POSTGRESQL
# =============================================================================
# One PostgreSQL server (single container) running three logical databases:
#   sentinel_core       — Core/Auth service (13 tables)
#   sentinel_detection  — Detection Engine (7 tables)
#   sentinel_ml        — ML Service (3 tables + 1 view)
#
# All three databases live on the same PostgreSQL server but have separate owners.
# The application will connect to one database at a time.
# When the three-service split is implemented, each service connects to its own DB.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

CORE_DB=sentinel_core
DETECTION_DB=sentinel_detection
ML_DB=sentinel_ml

# Full connection strings for each service database.
# When running the monolith, use CORE_DATABASE_URL.
# When running three separate services, each uses its own URL.
CORE_DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel_core
DETECTION_DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel_detection
ML_DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel_ml

# Legacy single-database URL (monolith only).
# Overridden by *_DATABASE_URL above when multi-database support is added.
DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel_core

# =============================================================================
# REDIS
# =============================================================================
# Used for future outbox/Redis Streams event transport (P1-G).
# PostgreSQL is the authoritative source of truth. Redis is a transport layer only.
# Do NOT use Redis to store sessions, users, or authoritative tokens.

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# =============================================================================
# INTERNAL SECRET
# =============================================================================
# Shared secret for internal service-to-service authentication.
# REQUIRED: Must be at least 32 characters.
# The application will refuse to start if this is absent, empty,
# or set to "changeme-in-production".
#
# Generate a new one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

INTERNAL_SECRET=change-me-to-a-secret-at-least-32-chars

# =============================================================================
# DETECTION ENGINE
# =============================================================================
# URL for the Detection Engine service.
# When running the monolith, this points to the same process.
# When running separate services, this points to the detection service.

DETECTION_URL=http://localhost:8001

# =============================================================================
# SECURITY
# =============================================================================
# Whether to call the Detection Engine's pre-token risk check before issuing tokens.
# "0" = disabled (default for development without detection service)
# "1" = enabled (requires detection service to be running)

RUN_PRE_TOKEN_CHECK=0

# =============================================================================
# TRUSTED PROXY
# =============================================================================
# Comma-separated list of IP addresses or CIDR blocks that are allowed to
# supply X-Forwarded-For / X-Forwarded-Proto headers.
#
# SAFE DEFAULT (development / Docker): 127.0.0.1
#   Only the local machine can supply forwarding headers.
#
# PRODUCTION with nginx/load-balancer:
#   Set this to the proxy's IP address, e.g. FORWARDED_ALLOW_IPS=10.10.0.5
#
# FORBIDDEN: FORWARDED_ALLOW_IPS=*
#   This would allow any remote client to forge X-Forwarded-For headers
#   and bypass IP-based controls (rate limiting, MFA binding, SOC audit).

FORWARDED_ALLOW_IPS=127.0.0.1

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

APP_ENV=development
